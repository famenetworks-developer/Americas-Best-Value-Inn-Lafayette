# Set to the final public origin before launching for search indexing.
SITE_URL=https://abvi-lafayette-stay.workspace-779429.chatgpt.site
# Keep false for private previews. Switch to true only for the public production site.
PUBLIC_INDEXING=false
# Optional account-issued verification values. Never enter account credentials.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Go CMS service and PostgreSQL. Generate strong unique production values.
DATABASE_URL=postgres://abvi:local-development-only@localhost:55432/abvi_cms?sslmode=disable
APP_ADDR=:18082
MEDIA_DIR=public/uploads
COOKIE_SECURE=false

# One-time first administrator bootstrap. Remove the password after creation.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Site Administrator
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-12-characters
POSTGRES_PASSWORD=local-development-only
